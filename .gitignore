# OS / editor junk
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*~
.idea/
.vscode/

# Logs & temp
*.log
npm-debug.log*
.cache/
tmp/
*.tmp

# Dependencies (this project has no build step; none should be committed)
node_modules/

# Environment / secrets — never commit these
.env
.env.*
*.pem
*.key

# Do NOT commit a copy of the curriculum dataset.
# Harrington downloads the Marble Skill Taxonomy at runtime and caches it under data/private/.
data/topics.json
data/dependencies.json
data/clusters.json
data/curriculum-standards.json
data/manifest.json

# Private family records written by the self-hosted server.
data/private/
backups/

# Local Claude Code config (machine-specific; not shared)
.claude/

# End-to-end test output (see docs/e2e/README.md). Screenshots under
# docs/e2e/screenshots/ are committed; videos and reports are not.
test-results/
playwright-report/
blob-report/
docs/e2e/recordings/
tests/e2e/.cache/
