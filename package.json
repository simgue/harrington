{
  "name": "harrington",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A private, self-hosted family learning platform built on the Marble Skill Taxonomy.",
  "scripts": {
    "start": "node server.mjs",
    "dev": "node --watch server.mjs",
    "build": "npm run build:css && npm run build:assets",
    "build:css": "tailwindcss -c tailwind.config.cjs -i src/css/tailwind-input.css -o src/css/tailwind.css --minify",
    "build:assets": "node scripts/build-assets.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "e2e": "node tests/e2e/run.mjs",
    "e2e:ui-docs": "node tests/e2e/run.mjs --refresh-docs",
    "e2e:mock-ai": "node tests/e2e/mock-ai-server.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/lexend": "^5.3.0",
    "@playwright/test": "^1.56.1",
    "lucide": "^0.468.0",
    "tailwindcss": "^3.4.17"
  }
}
