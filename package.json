{
  "name": "harrington",
  "version": "1.0.0",
  "private": true,
  "description": "A private, self-hosted family learning platform built on the Marble Skill Taxonomy.",
  "scripts": {
    "start": "node server.mjs",
    "dev": "node --watch server.mjs",
    "build": "npm run build:css && npm run build:assets",
    "build:css": "tailwindcss -c tailwind.config.cjs -i src/css/tailwind-input.css -o src/css/tailwind.css --minify",
    "build:assets": "node scripts/build-assets.mjs",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "lucide": "^0.468.0",
    "tailwindcss": "^3.4.17"
  }
}
